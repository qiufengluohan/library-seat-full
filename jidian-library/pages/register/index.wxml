<view class="reg-page">

  <!-- 自定义导航：本页 navigationStyle 是 custom，系统不出导航栏，
       所以返回键要自己画一个，否则用户只能靠手势返回 -->
  <view class="nav" style="padding-top: {{statusBarHeight}}px">
    <view class="nav-inner">
      <view class="nav-back" bindtap="goBack">
        <view class="arrow-left"></view>
      </view>
      <view class="nav-title">注册账号</view>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="reg-body">
    <view class="card-title">创建账号</view>
    <view class="card-desc">使用学号注册，注册成功后自动登录</view>

    <view class="form">
      <view class="field">
        <text class="field-label">学号 <text class="req">*</text></text>
        <input
          class="field-input"
          type="text"
          maxlength="32"
          placeholder="4~32 位字母或数字"
          placeholder-class="field-ph"
          value="{{form.studentNo}}"
          data-key="studentNo"
          bindinput="onInput"
        />
      </view>

      <view class="field">
        <text class="field-label">密码 <text class="req">*</text></text>
        <input
          class="field-input"
          password="{{true}}"
          maxlength="32"
          placeholder="6~32 位"
          placeholder-class="field-ph"
          value="{{form.password}}"
          data-key="password"
          bindinput="onInput"
        />
      </view>

      <view class="field">
        <text class="field-label">确认密码 <text class="req">*</text></text>
        <input
          class="field-input"
          password="{{true}}"
          maxlength="32"
          placeholder="请再次输入密码"
          placeholder-class="field-ph"
          value="{{form.confirm}}"
          data-key="confirm"
          bindinput="onInput"
        />
      </view>

      <view class="field">
        <text class="field-label">昵称（选填）</text>
        <!-- type="nickname" 的坑：用户点键盘上「使用微信昵称」填充时不触发 bindinput，
             值只在失焦那一刻给出来。只挂 bindinput 就会「屏幕上有昵称、提交的却是空」，
             因此 bindblur 必须一起挂上（与 pages/mine 的写法一致）。 -->
        <input
          class="field-input"
          type="nickname"
          maxlength="64"
          placeholder="不填则显示为「同学」"
          placeholder-class="field-ph"
          value="{{form.nickname}}"
          data-key="nickname"
          bindinput="onInput"
          bindblur="onInput"
        />
      </view>
    </view>

    <button class="btn btn-primary btn-block reg-btn" bindtap="onRegister" disabled="{{submitting}}">
      {{submitting ? '注册中…' : '注 册'}}
    </button>

    <view class="tip">
      注册即在图书馆系统中建立账号，密码用于登录本系统；
      如需修改密码请联系图书馆管理员。
    </view>
  </view>
</view>
