.page-wrap {
  min-height: 100vh;
  background: #F4F7FC;
  padding-bottom: 40rpx;
}

/* ---------- 头部 ---------- */
.hd {
  background: #fff;
  padding-bottom: 0;
  box-shadow: 0 4rpx 20rpx rgba(58, 107, 240, 0.05);
}
.hd-row {
  height: 88rpx; display: flex; align-items: center; justify-content: center;
  position: relative; padding: 0 28rpx;
}
.hd-title { font-size: 34rpx; font-weight: 700; color: #1B2333; }
.hd-add {
  position: absolute; right: 28rpx; top: 50%; transform: translateY(-50%);
  height: 56rpx; padding: 0 24rpx; border-radius: 28rpx;
  background: #EBF1FE; color: #3A6BF0; font-size: 24rpx; font-weight: 600;
  display: flex; align-items: center;
}

/* ---------- 状态筛选 ---------- */
.tabs {
  white-space: nowrap;
  padding: 20rpx 20rpx 4rpx;
  background: #fff;
}
.tab {
  display: inline-flex; align-items: center;
  height: 64rpx; padding: 0 28rpx; border-radius: 32rpx;
  font-size: 26rpx; color: #5B6478;
  background: #F4F7FC; margin: 0 12rpx 16rpx 0;
}
.tab.on {
  background: linear-gradient(135deg, #5B8CFF, #3A6BF0);
  color: #fff; font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(58, 107, 240, 0.25);
}
.tab-num {
  font-size: 20rpx; margin-left: 8rpx;
  background: rgba(58, 107, 240, 0.12); color: #3A6BF0;
  border-radius: 16rpx; padding: 2rpx 10rpx;
}
.tab.on .tab-num { background: rgba(255, 255, 255, 0.28); color: #fff; }

/* ---------- 列表 ---------- */
.list { padding: 24rpx 28rpx 0; }
.group { margin-bottom: 8rpx; }
.group-date {
  display: flex; align-items: baseline;
  padding: 18rpx 6rpx 16rpx;
}
.gd-main { font-size: 28rpx; font-weight: 700; color: #1B2333; }
.gd-sub { font-size: 22rpx; color: #AAB2C0; margin-left: 12rpx; }

/* ---------- 预约卡片 ---------- */
.res-card {
  background: #fff; border-radius: 28rpx; padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: 0 8rpx 28rpx rgba(58, 107, 240, 0.07);
}
.rc-ico {
  width: 46rpx; height: 46rpx; border-radius: 15rpx; margin-right: 14rpx;
  background: linear-gradient(135deg, #5B8CFF, #3A6BF0);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.rc-ico-in { width: 18rpx; height: 18rpx; border-radius: 6rpx; background: #fff; }
.rc-right { flex-shrink: 0; margin-left: 16rpx; }

.rc-time {
  display: flex; align-items: center;
  margin: 26rpx 0 8rpx;
}
.rc-clock { font-size: 52rpx; font-weight: 700; color: #1B2333; letter-spacing: -1rpx; }
/* 预约 / 签到 / 离座 三段时间（规范字段：reserve_time / sign_time / release_time） */
.rc-t { flex: 1; min-width: 0; }
.rc-t-label { font-size: 21rpx; color: #AAB2C0; }
.rc-t-value { font-size: 30rpx; font-weight: 700; color: #1B2333; margin-top: 6rpx; }
.rc-dur {
  font-size: 21rpx; color: #8A94A6; background: #F2F5FA;
  padding: 8rpx 20rpx; border-radius: 22rpx;
  margin: 0 auto;
}

.rc-meta {
  display: flex; border-top: 2rpx solid #EEF1F6;
  padding-top: 22rpx; margin-top: 20rpx;
}
.rc-meta-item { flex: 1; }
.rc-meta-label { font-size: 21rpx; color: #AAB2C0; }
.rc-meta-value { font-size: 26rpx; color: #1B2333; font-weight: 600; margin-top: 8rpx; }
.fac {
  display: inline-block; font-size: 20rpx; color: #3A6BF0;
  background: #EBF1FE; padding: 3rpx 10rpx; border-radius: 6rpx;
  margin-right: 6rpx; font-weight: 500;
}

.rc-actions {
  display: flex; justify-content: flex-end;
  margin-top: 24rpx; padding-top: 22rpx;
  border-top: 2rpx solid #EEF1F6;
}
.rc-btn {
  height: 64rpx; padding: 0 30rpx; border-radius: 32rpx;
  font-size: 25rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
  margin-left: 16rpx;
}
.rc-btn.ghost { background: #F4F7FC; color: #5B6478; }
.rc-btn.primary {
  background: linear-gradient(135deg, #5B8CFF, #3A6BF0);
  color: #fff; box-shadow: 0 8rpx 18rpx rgba(58, 107, 240, 0.24);
}

.foot-tip {
  text-align: center; font-size: 21rpx; color: #AAB2C0;
  padding: 30rpx 40rpx 0;
}
