@import "../../styles/nav.wxss";

.nav-bar { background: #fff; }

.wrap { min-height: 100vh; background: #F4F7FC; padding-bottom: 60rpx; }
.body { padding: 24rpx 28rpx 0; }

.seat-info {
  font-size: 26rpx; color: #1B2333; line-height: 1.8;
  background: #F7F9FD; border-radius: 20rpx; padding: 22rpx 24rpx;
  white-space: pre-wrap;
}

.chips { display: flex; flex-wrap: wrap; }
.chip {
  height: 66rpx; padding: 0 30rpx; border-radius: 33rpx;
  background: #F4F7FC; color: #5B6478; font-size: 25rpx;
  display: flex; align-items: center;
  margin: 0 16rpx 16rpx 0;
}
.chip.on {
  background: linear-gradient(135deg, #5B8CFF, #3A6BF0);
  color: #fff; font-weight: 600;
}

.ta {
  width: 100%; height: 240rpx;
  font-size: 27rpx; line-height: 1.7; color: #1B2333;
  background: #F7F9FD; border-radius: 20rpx;
  padding: 24rpx;
}
.ph { color: #AAB2C0; }
.ta-count { text-align: right; font-size: 21rpx; color: #AAB2C0; margin-top: 10rpx; }

.upload { display: flex; flex-wrap: wrap; margin-top: 10rpx; }
.up-item { position: relative; margin-right: 20rpx; margin-bottom: 16rpx; }
.up-img { width: 160rpx; height: 160rpx; border-radius: 18rpx; }
.up-del {
  position: absolute; right: -10rpx; top: -10rpx;
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(17, 24, 39, 0.7); color: #fff;
  font-size: 26rpx; display: flex; align-items: center; justify-content: center;
}
.up-add {
  width: 160rpx; height: 160rpx; border-radius: 18rpx;
  background: #F7F9FD; border: 2rpx dashed #C6D3EE;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.up-add-ico { font-size: 40rpx; color: #7E9DF5; line-height: 1; }
.up-add-txt { font-size: 21rpx; color: #AAB2C0; margin-top: 8rpx; }

.input {
  font-size: 27rpx; color: #1B2333;
  background: #F7F9FD; border-radius: 20rpx;
  padding: 24rpx; height: 88rpx;
}

.tel-card { display: flex; align-items: center; margin-top: 24rpx; }
.tel-ico {
  width: 76rpx; height: 76rpx; border-radius: 24rpx; margin-right: 20rpx;
  background: #E4F8F1; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.tel-ico image { width: 38rpx; height: 38rpx; }

.foot-tip {
  font-size: 21rpx; color: #AAB2C0; line-height: 1.7;
  text-align: center; margin-top: 26rpx; padding: 0 20rpx;
}
