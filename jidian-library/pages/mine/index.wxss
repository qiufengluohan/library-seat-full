.wrap { min-height: 100vh; background: var(--bg); }

/* ============ 头部 ============ */
.hd {
  position: relative; overflow: hidden;
  padding-bottom: 34rpx;
  background: linear-gradient(160deg, #5B8CFF, #3A6BF0);
}
.hd-bg { position: absolute; border-radius: 50%; }
.hd-bg.a {
  width: 380rpx; height: 380rpx; right: -130rpx; top: -170rpx;
  background: rgba(255, 255, 255, 0.12);
}
.hd-bg.b {
  width: 220rpx; height: 220rpx; left: -80rpx; top: 40rpx;
  background: rgba(255, 255, 255, 0.08);
}

.profile { position: relative; display: flex; align-items: center; padding: 30rpx 32rpx 0; }
.avatar-btn {
  width: 120rpx; height: 120rpx; padding: 0; margin: 0;
  border-radius: 60rpx; background: transparent; line-height: 1;
  overflow: hidden; flex-shrink: 0;
}
.avatar-btn::after { border: none; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 60rpx; display: block; }
.avatar-ph { background: rgba(255, 255, 255, 0.28); border: 3rpx solid rgba(255, 255, 255, 0.5); }

.pinfo { flex: 1; min-width: 0; margin-left: 24rpx; }
.pname { font-size: 36rpx; font-weight: 700; color: #fff; }
.psub { font-size: 23rpx; color: rgba(255, 255, 255, 0.82); margin-top: 10rpx; }

/* ============ 主体 ============ */
.body { padding: 24rpx 28rpx 0; }

.row {
  display: flex; align-items: center;
  min-height: 92rpx; padding: 10rpx 0;
  border-bottom: 2rpx solid #F2F5FA;
}
.label { width: 150rpx; flex-shrink: 0; font-size: 27rpx; color: #6E7686; }
.input { flex: 1; min-width: 0; font-size: 27rpx; color: #1B2333; text-align: right; }
.ph { color: #C2C9D6; }

.info-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0; border-bottom: 2rpx solid #F2F5FA;
}
.info-row:last-of-type { border-bottom: none; }
.info-k { font-size: 25rpx; color: #8A94A6; flex-shrink: 0; margin-right: 24rpx; }
.info-v { font-size: 26rpx; color: #1B2333; font-weight: 600; max-width: 420rpx; text-align: right; }

.tip {
  margin-top: 20rpx; padding: 20rpx 22rpx;
  background: #F7F9FD; border-radius: 14rpx;
  font-size: 21rpx; color: #8A94A6; line-height: 1.7;
}

/* ============ 我的预约 ============ */
.status-grid { display: flex; padding: 26rpx 0 6rpx; }
.sg-item { flex: 1; display: flex; flex-direction: column; align-items: center; }
.sg-ico {
  width: 84rpx; height: 84rpx; border-radius: 26rpx;
  display: flex; align-items: center; justify-content: center;
  position: relative;
}
.sg-ico image { width: 42rpx; height: 42rpx; }
.sg-badge {
  position: absolute; right: -6rpx; top: -6rpx;
  min-width: 30rpx; height: 30rpx; padding: 0 8rpx; border-radius: 15rpx;
  background: #F0554B; color: #fff; font-size: 19rpx; line-height: 30rpx;
  text-align: center;
}
.sg-label { font-size: 23rpx; color: #5B6478; margin-top: 14rpx; }

.latest {
  display: flex; align-items: center; gap: 20rpx;
  background: #F7F9FD; border-radius: 16rpx;
  padding: 24rpx 22rpx; margin-top: 24rpx;
}
.latest-left { flex: 1; min-width: 0; }
.latest-title { font-size: 28rpx; font-weight: 700; color: #1B2333; margin-top: 12rpx; }
.latest-time { font-size: 22rpx; color: #8A94A6; margin-top: 8rpx; }
.latest-btn {
  flex-shrink: 0; height: 60rpx; padding: 0 26rpx; border-radius: 30rpx;
  background: var(--primary); color: #fff; font-size: 24rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center;
}
.empty-latest { justify-content: space-between; }
.empty-latest text { font-size: 24rpx; color: #8A94A6; }

/* ============ 底部 ============ */
.logout {
  margin: 40rpx 0 0; text-align: center;
  font-size: 27rpx; color: #C53A30; padding: 26rpx 0;
}
.brand-foot {
  text-align: center; font-size: 21rpx; color: #AAB2C0;
  padding: 10rpx 0 50rpx;
}
