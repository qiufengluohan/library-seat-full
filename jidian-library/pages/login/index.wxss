.login-page { min-height: 100vh; background: var(--bg); display: flex; flex-direction: column; }

/* ---------- 品牌区 ---------- */
.brand {
  position: relative; overflow: hidden;
  padding-bottom: 130rpx;
  background: linear-gradient(160deg, #5B8CFF, #3A6BF0);
}
.brand-mask { position: absolute; border-radius: 50%; }
.brand-mask.a {
  width: 420rpx; height: 420rpx; right: -140rpx; top: -160rpx;
  background: rgba(255, 255, 255, 0.12);
}
.brand-mask.b {
  width: 260rpx; height: 260rpx; left: -100rpx; top: 60rpx;
  background: rgba(255, 255, 255, 0.08);
}
.brand-inner { position: relative; text-align: center; color: #fff; }
.logo { display: flex; align-items: flex-end; justify-content: center; height: 96rpx; }
.logo-book { border-radius: 6rpx; background: rgba(255, 255, 255, 0.92); margin: 0 4rpx; }
.logo-book.b1 { width: 20rpx; height: 62rpx; }
.logo-book.b2 { width: 20rpx; height: 82rpx; }
.logo-book.b3 { width: 20rpx; height: 70rpx; }
.brand-title { font-size: 44rpx; font-weight: 700; margin-top: 26rpx; letter-spacing: 2rpx; }
.brand-sub { font-size: 22rpx; opacity: 0.85; margin-top: 12rpx; letter-spacing: 1rpx; }

/* ---------- 登录卡片 ---------- */
.login-card {
  margin: -90rpx 40rpx 0; position: relative;
  background: #fff; border-radius: 28rpx;
  padding: 48rpx 40rpx 40rpx;
  box-shadow: 0 16rpx 44rpx rgba(58, 107, 240, 0.12);
}
.card-title { font-size: 38rpx; font-weight: 700; color: var(--text-1); }
.card-desc { font-size: 24rpx; color: var(--text-3); margin-top: 12rpx; line-height: 1.6; }

/* ---------- 表单 ---------- */
.form { margin-top: 40rpx; }
.field { margin-bottom: 30rpx; }
.field-label {
  display: block; font-size: 24rpx; color: var(--text-2);
  margin-bottom: 14rpx;
}
.field-input {
  height: 88rpx; padding: 0 24rpx;
  background: var(--bg); border-radius: 16rpx;
  font-size: 28rpx; color: var(--text-1);
  box-sizing: border-box; width: 100%;
}
.field-ph { color: var(--text-4); }

/* ---------- 按钮 ---------- */
.wx-btn { margin-top: 20rpx; }
.wx-btn::after { border: none; }

.to-register {
  margin-top: 30rpx; text-align: center;
  font-size: 24rpx; color: var(--text-3);
}
.agree-text {
  margin-top: 20rpx; text-align: center;
  font-size: 21rpx; color: var(--text-4); line-height: 1.7;
}
.link { color: var(--primary); }

.footer {
  margin-top: auto; padding: 40rpx 0 50rpx;
  text-align: center; font-size: 21rpx; color: var(--text-4);
}
