@import "../../styles/nav.wxss";

.wrap { min-height: 100vh; background: #F4F7FC; }
.nav-bar { background: #fff; }

/* ---------- 空态（未配置后端 / 请求失败） ---------- */
.empty-card { text-align: center; padding: 60rpx 32rpx 50rpx; }
.empty-ico {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: #FEECEA; color: #C53A30;
  font-size: 42rpx; font-weight: 700;
  margin: 0 auto 22rpx;
  display: flex; align-items: center; justify-content: center;
}
.empty-title { font-size: 32rpx; font-weight: 700; color: #1B2333; }
.empty-desc { font-size: 23rpx; color: #8A94A6; line-height: 1.7; margin-top: 14rpx; text-align: left; }
.body { padding: 24rpx 28rpx 0; }

/* ---------- 阅览室切换 ---------- */
.room-tabs { white-space: nowrap; margin-bottom: 24rpx; }
.room-tab {
  display: inline-flex; flex-direction: column; align-items: center; justify-content: center;
  min-width: 176rpx; height: 96rpx; padding: 0 24rpx;
  border-radius: 24rpx; background: #fff;
  margin-right: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(58, 107, 240, 0.05);
}
.room-tabs .room-tab:last-child { margin-right: 0; }
.room-tab text { font-size: 25rpx; color: #5B6478; font-weight: 600; }
.room-tab-floor { font-size: 20rpx !important; color: #AAB2C0 !important; font-weight: 400 !important; margin-top: 6rpx; }
.room-tab.on { background: linear-gradient(150deg, #5B8CFF, #3A6BF0); box-shadow: 0 10rpx 24rpx rgba(58, 107, 240, 0.28); }
.room-tab.on text { color: #fff; }
.room-tab.on .room-tab-floor { color: rgba(255, 255, 255, 0.75) !important; }

/* ---------- 图例（规范 39 节配色） ---------- */
.legend {
  display: flex; align-items: center; flex-wrap: wrap;
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid #EEF1F6;
}
.lg-item { display: flex; align-items: center; margin-right: 24rpx; }
.lg-dot { width: 26rpx; height: 26rpx; border-radius: 8rpx; margin-right: 10rpx; }
.lg-txt { font-size: 22rpx; color: #8A94A6; }
.lg-free { background: #EAF9F3; border: 3rpx solid #8FDCBF; }
.lg-reserved { background: #FEF3E0; border: 3rpx solid #F5A623; }
.lg-using { background: #FDEAE8; border: 3rpx solid #F0554B; }
.lg-away { background: #EFF2F7; border: 3rpx solid #9AA4B8; }
.lg-alarm { background: #FDEAE8; border: 3rpx solid #F0554B; }

.stats { display: flex; padding-top: 24rpx; }
.st-item { flex: 1; text-align: center; }
.st-num { font-size: 38rpx; font-weight: 700; color: #1B2333; }
.st-label { font-size: 21rpx; color: #AAB2C0; margin-top: 4rpx; }
.stats-sub { font-size: 21rpx; color: #AAB2C0; line-height: 1.6; margin-top: 16rpx; }

/* ---------- 座位图 ---------- */
.map-frame {
  background: #F7F9FD; border-radius: 24rpx;
  padding: 20rpx 16rpx 24rpx;
  border: 2rpx solid #EEF1F6;
}
.map-window {
  text-align: center; font-size: 20rpx; color: #C2C9D6;
  letter-spacing: 10rpx; margin-bottom: 18rpx;
  border-bottom: 3rpx dashed #E2E8F4; padding-bottom: 10rpx;
}
.map-row { display: flex; align-items: center; margin-bottom: 12rpx; }
.map-row:last-child { margin-bottom: 0; }

.cell { margin-right: 6rpx; flex-shrink: 0; }
.cell.aisle { background: transparent !important; border: none !important; width: 16rpx; }
/* 该行列没有座位时的占位格 */
.cell.blank { background: transparent; border: 3rpx dashed #E8ECF3; border-radius: 10rpx; }
.map-row .cell:last-child { margin-right: 0; }

.seat {
  border-radius: 10rpx;
  display: flex; align-items: center; justify-content: center;
  position: relative;
  border: 3rpx solid transparent;
}
.cell-txt { font-size: 17rpx; font-weight: 600; line-height: 1; }

/* 0 空闲 —— 绿 */
.s-free { background: #EAF9F3; border-color: #8FDCBF; }
.s-free .cell-txt { color: #1B8F68; }
/* 1 已预约 —— 黄 */
.s-reserved { background: #FEF3E0; border-color: #F5A623; }
.s-reserved .cell-txt { color: #B8730F; }
/* 2 使用中 —— 红 */
.s-using { background: #FDEAE8; border-color: #F0554B; }
.s-using .cell-txt { color: #C53A30; }
/* 3 暂离 —— 灰 */
.s-away { background: #EFF2F7; border-color: #9AA4B8; }
.s-away .cell-txt { color: #6E7686; }
/* 4 异常告警 —— 红闪 */
.s-alarm { background: #FDEAE8; border-color: #F0554B; animation: blink 1.1s ease-in-out infinite; }
.s-alarm .cell-txt { color: #C53A30; }
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.32; }
}

/* 我的座位：加一圈紫边 */
.seat.mine { box-shadow: 0 0 0 3rpx #7A6BFF inset; }

/* 当前选中 */
.seat.picked {
  background: linear-gradient(150deg, #5B8CFF, #3A6BF0);
  border-color: #3A6BF0;
  transform: scale(1.16);
  box-shadow: 0 8rpx 18rpx rgba(58, 107, 240, 0.36);
  z-index: 3;
}
.seat.picked .cell-txt { color: #fff; }

/* 设备离线角标（离线不覆盖业务状态，只加角标） */
.cell-off {
  position: absolute; left: 50%; bottom: -10rpx; transform: translateX(-50%);
  padding: 0 6rpx; height: 20rpx; line-height: 20rpx;
  border-radius: 6rpx; background: #6E7686; color: #fff;
  font-size: 14rpx; white-space: nowrap;
}

/* 已接入传感器的座位：左上角绿点 */
.seat.live::after {
  content: '';
  position: absolute; left: -3rpx; top: -5rpx;
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #22C08A;
  border: 2rpx solid #fff;
}
.seat.picked.live::after { background: #fff; }

/* ---------- OneNET 覆盖提示 ---------- */
.live-chip {
  display: flex; align-items: center;
  margin-top: 18rpx; padding: 16rpx 20rpx;
  background: #E9F9F3; border-radius: 14rpx;
}
.live-chip.err { background: #FEECEA; }
.live-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #22C08A; margin-right: 12rpx; flex-shrink: 0;
}
.live-txt { font-size: 21rpx; color: #1B8F68; line-height: 1.5; }
.live-chip.err .live-txt { color: #C53A30; }

.map-tip {
  display: flex; align-items: flex-start;
  margin-top: 18rpx; font-size: 21rpx; color: #AAB2C0; line-height: 1.6;
}
.tip-ico {
  width: 26rpx; height: 26rpx; border-radius: 50%;
  background: #EBF1FE; color: #3A6BF0;
  font-size: 18rpx; font-style: italic;
  display: flex; align-items: center; justify-content: center;
  margin-right: 10rpx; flex-shrink: 0; margin-top: 2rpx;
}

.holder { height: 200rpx; }
.foot-inner { display: flex; align-items: center; }
.foot-info { flex: 1; min-width: 0; }
.foot-btn { width: 240rpx; flex-shrink: 0; }

/* ---------- 确认弹窗 ---------- */
.cf-title { font-size: 32rpx; font-weight: 700; color: #1B2333; text-align: center; }
.cf-art { display: flex; justify-content: center; margin: 28rpx 0 10rpx; }
.cf-seat { display: flex; flex-direction: column; align-items: center; }
.cf-seat-back {
  width: 120rpx; height: 76rpx; border-radius: 22rpx;
  background: #BFD3FB;
}
.cf-seat-pad {
  width: 152rpx; height: 34rpx; border-radius: 17rpx;
  background: linear-gradient(150deg, #5B8CFF, #3A6BF0);
  margin-top: 10rpx;
  box-shadow: 0 8rpx 18rpx rgba(58, 107, 240, 0.28);
}
.cf-rows { margin-top: 26rpx; }
.cf-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F2F5FA;
}
.cf-row:last-child { border-bottom: none; }
.cf-k { font-size: 25rpx; color: #8A94A6; }
.cf-v { font-size: 26rpx; color: #1B2333; font-weight: 600; }
.cf-note {
  margin-top: 20rpx; padding: 18rpx 20rpx;
  background: #F7F9FD; border-radius: 14rpx;
  font-size: 21rpx; color: #8A94A6; line-height: 1.6;
}
